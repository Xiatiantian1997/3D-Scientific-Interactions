{
  "version": "3.0",
  "goal": "区分沿位置排列的复数值形成螺旋图形与粒子螺旋轨迹，观察固定位置的相位变化。",
  "model": {
    "assumptions": "ψ=exp[i(kx−2πt/T)]，幅度1，波长3个示意长度单位；有限视窗截取无限平面波。坐标为x、Reψ、Imψ，后两者不是空间方向。",
    "evidence": "欧拉公式及恒相位条件kx−ωt=常数；归一化幅度只作示意，不是可归一化单粒子波包。"
  },
  "states": [
    {
      "id": "oblique",
      "meaning": "空间x与两个复数分量组成的斜视图"
    },
    {
      "id": "axial",
      "meaning": "沿x轴看复数平面"
    },
    {
      "id": "playing",
      "meaning": "时间前进一周期；固定位置不变"
    },
    {
      "id": "paused",
      "meaning": "固定时刻旋转观察"
    }
  ],
